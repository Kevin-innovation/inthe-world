# Convex deployment URL from `npx convex dev` or the Convex dashboard.
# Next loads this from the repo root (see apps/web/next.config.ts).
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# CI / Vercel only. Used by `npx convex deploy`. Never commit the real key.
# CONVEX_DEPLOY_KEY=
